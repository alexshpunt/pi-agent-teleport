{
  "name": "pi-agent-teleport",
  "version": "0.1.1",
  "description": "Give your agent a teleportation gun: move one Pi session between directories and managed Git worktrees",
  "type": "module",
  "license": "MIT",
  "author": "Alex Shpunt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-agent-teleport.git"
  },
  "homepage": "https://github.com/alexshpunt/pi-agent-teleport#readme",
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-agent-teleport/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run src",
    "test:integration": "pi-test run -- vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "typebox": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "pi-coding-agent-test": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
