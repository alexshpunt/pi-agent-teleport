{
  "name": "pi-agent-teleport",
  "version": "0.2.0",
  "description": "Move a running Pi Coding Agent session between directories, repositories, and isolated Git worktrees",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "coding-agent",
    "ai-agent",
    "git",
    "git-worktree",
    "worktree",
    "session-management",
    "developer-tools",
    "agentic-coding",
    "coding-tools",
    "git-tools",
    "development-workflow",
    "worktrees",
    "repository-management"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Aleksandr Shpuntenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-agent-teleport.git"
  },
  "homepage": "https://github.com/alexshpunt/pi-agent-teleport#readme",
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-agent-teleport/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/index.ts",
    "src/core.ts",
    "assets/agent-portal.webp",
    "assets/agent-portal-gallery.webp",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/alexshpunt/pi-agent-teleport/v0.1.6/assets/agent-portal-gallery.webp"
  },
  "scripts": {
    "test": "vitest run src",
    "test:integration": "pi-test run -- vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "pi-coding-agent-test": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
